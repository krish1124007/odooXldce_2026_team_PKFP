# ==================================================
# GLOBETROTTER MASTER ENVIRONMENT VARIABLES
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/globetrotter

# Authentication Secret (Phase 2)
JWT_SECRET=your_jwt_secret_key_here

# Groq Agentic AI Configuration (Phase 6 - SERVER ONLY)
# NEVER EXPOSE GROQ_API_KEY TO THE CLIENT/FRONTEND
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Frontend Configuration (Client)
VITE_API_URL=http://localhost:5000/api
